# ---------------------------------------------------------------------------
# CarbonShift environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. No real secret belongs in this file.
# ---------------------------------------------------------------------------

# --- Carbon data provider (Electricity Maps) -------------------------------
# API token from https://portal.electricitymaps.com/
# Confirm your free-tier plan actually covers the zone below BEFORE building
# against it -- the free tier is usually limited to a single "home zone".
ELECTRICITY_MAPS_API_KEY=your-electricity-maps-token

# Electricity Maps zone to fetch the forecast for, e.g. DE, GB, IN-WE,
# US-MIDA-PJM. If unset, CarbonShift derives it from AWS_REGION using the
# lookup table in src/scheduler.py.
CARBON_ZONE=

# --- AWS -------------------------------------------------------------------
# AWS credentials are read by boto3 from the standard chain (env vars, shared
# credentials file, or an instance role). Set them here only if you are not
# using `aws configure`.
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Resources provisioned by infra/deploy.py ------------------------------
# Run `python infra/deploy.py` once; it prints these values for you to paste in.
ECS_CLUSTER_ARN=
WORKER_TASK_DEFINITION_ARN=
SCHEDULER_ROLE_ARN=
WORKER_SUBNET_IDS=subnet-aaaa,subnet-bbbb
WORKER_SECURITY_GROUP_IDS=sg-cccc
WORKER_ASSIGN_PUBLIC_IP=ENABLED

# Container image for the worker, e.g.
# 123456789012.dkr.ecr.eu-central-1.amazonaws.com/carbonshift-worker:latest
WORKER_IMAGE_URI=

# --- Carbon accounting constants -------------------------------------------
# Used to convert the worker's compute into energy, and energy into gCO2.
WORKER_VCPU=2
WORKER_RUNTIME_HOURS=0.5
KWH_PER_VCPU_HOUR=0.0074

# --- Worker behaviour ------------------------------------------------------
# How long the demo workload sleeps, to make the run observable in logs.
WORKER_RUN_SECONDS=5

# Organisation name printed on carbon reports (optional)
CARBONSHIFT_ORGANISATION=
